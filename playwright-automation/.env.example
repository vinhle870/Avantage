# Copy to .env and fill in. .env is gitignored.
ENV_NAME=Staging
BASE_URL=https://v2staging.garantieavantageplus.ca
ADMIN_PORTAL_URL=https://v2staging.garantieavantageplus.ca/admin/login
DEALER_PORTAL_URL=https://v2staging.garantieavantageplus.ca/login

ADMIN_USERNAME=
ADMIN_PASSWORD=
DEALER_USERNAME=
DEALER_PASSWORD=

# Parallel workers. The dealer flows read the newest inventory row, so keep 1 unless
# each worker uses its own dealer account.
WORKERS=1
