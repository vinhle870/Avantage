{
  "name": "playwright-automation",
  "version": "1.0.0",
  "description": "Avantage Automation Test Framework - Playwright TypeScript",
  "main": "index.js",
  "scripts": {
    "test": "npx playwright test --project=chromium",
    "test:unit": "npx playwright test --project=unit",
    "test:admin": "npx playwright test --project=chromium src/tests/admin/",
    "test:dealer": "npx playwright test --project=chromium src/tests/dealer/",
    "test:warranty": "npx playwright test --project=chromium --grep @warranty",
    "test:sale-contract": "npx playwright test --project=chromium --grep @saleContract",
    "test:headed": "npx playwright test --project=chromium --headed",
    "test:debug": "npx playwright test --project=chromium --debug",
    "report": "npx playwright show-report",
    "lint": "npx tsc --noEmit"
  },
  "keywords": [
    "playwright",
    "automation",
    "testing",
    "typescript"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@types/node": "^25.0.9",
    "@types/xml2js": "^0.4.14",
    "dotenv": "^17.2.3",
    "pdfjs-dist": "^4.10.38",
    "typescript": "^5.9.3",
    "xml2js": "^0.5.0"
  }
}
