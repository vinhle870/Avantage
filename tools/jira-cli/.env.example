# Copy to the REPO ROOT as /.env (gitignored) and fill in.
# This file is the single source of truth for the Jira connection — the wrappers
# sync tools/jira-cli/config.yml from it on every run.

# --- Jira site ---
JIRA_SITE_URL=https://your-site.atlassian.net
JIRA_PROJECT=AP

# Atlassian account that can open the site above.
# Must be the SAME account that generated the token below.
JIRA_LOGIN=you@example.com

# Unscoped token ("Create API token", NOT "with scopes"):
#   https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=
